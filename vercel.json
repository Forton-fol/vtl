{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/static" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/\\.netlify/functions/(.*)$", "dest": "/api/$1" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
